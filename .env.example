# ===========================================
# 봄길 (Bomgil) 환경 변수
# ===========================================
# 이 파일을 .env로 복사한 후 값을 수정하세요
# cp .env.example .env

# --- Django ---
SECRET_KEY=your-secret-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=bomgil
DB_USER=bomgil
DB_PASSWORD=bomgil
DB_HOST=postgres
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---
# Access: 30min, Refresh: 7days (configured in settings.py)

# --- Social Login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- Storage (S3 compatible, optional for dev) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# --- Kakao Maps ---
NEXT_PUBLIC_KAKAO_MAP_KEY=

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
